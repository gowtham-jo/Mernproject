# =============================================================
# LearnHub LMS - Server Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# =============================================================

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (used for CORS and email links)
CLIENT_URL=https://mernproject-eta.vercel.app

# Backend URL (used for reference)
SERVER_URL=https://mernproject-3ht6.onrender.com

# =============================================================
# REQUIRED: MongoDB Connection String
# =============================================================
# For MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# For local MongoDB: mongodb://127.0.0.1:27017/learnhub_lms
# IMPORTANT: The server will NOT start without this variable set.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/learnhub_lms?retryWrites=true&w=majority

# =============================================================
# REQUIRED: JWT Secret
# =============================================================
# Use a long, random, unique secret. Example: openssl rand -hex 64
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Seed password for initial admin/teacher accounts
SEED_PASSWORD=Password123!

# Cloudinary (Optional - local fallback used if blank)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email SMTP (Optional - logs to console if blank)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@learnhub.com
